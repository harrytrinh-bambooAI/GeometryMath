{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ma_tran.schema.json",
 "title": "Ma trận đề (v1.0 · 27/11/2026)",
 "type": "object",
 "required": [
  "id",
  "ten",
  "loai_de",
  "lop",
  "thoi_gian_phut",
  "tong_diem",
  "phan",
  "can_cu",
  "gia_dinh",
  "cells",
  "bang",
  "phien_ban"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "ten": {
   "type": "string"
  },
  "loai_de": {
   "enum": [
    "kiem-tra-15",
    "giua-ki",
    "cuoi-ki",
    "thi-thu-tn-thpt"
   ]
  },
  "lop": {
   "enum": [
    10,
    11,
    12
   ]
  },
  "thoi_gian_phut": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "tong_diem": {
   "type": "number"
  },
  "phan": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "ten",
     "loai_cau",
     "so_cau",
     "diem_moi_cau"
    ],
    "properties": {
     "loai_cau": {
      "enum": [
       "tn4",
       "dung-sai",
       "tra-loi-ngan",
       "tu-luan"
      ]
     },
     "so_cau": {
      "type": "integer",
      "minimum": 1
     },
     "diem_moi_cau": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    }
   }
  },
  "can_cu": {
   "type": "array",
   "minItems": 1
  },
  "gia_dinh": {
   "type": "array"
  },
  "cells": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "phan",
     "loai_cau",
     "muc_do",
     "so_cau",
     "diem",
     "dac_ta",
     "loai_o"
    ],
    "properties": {
     "loai_cau": {
      "enum": [
       "tn4",
       "dung-sai",
       "tra-loi-ngan",
       "tu-luan"
      ]
     },
     "muc_do": {
      "enum": [
       "NB",
       "TH",
       "VD",
       "VDC"
      ]
     },
     "so_cau": {
      "type": "integer",
      "minimum": 1
     },
     "diem": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "dac_ta": {
      "type": "string",
      "minLength": 5
     },
     "loai_o": {
      "enum": [
       "co-dinh",
       "xoay-vong"
      ]
     },
     "yccd": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^(10|11|12)\\.[A-Z]+\\.[0-9]+$"
      }
     },
     "nhom": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "chu_de",
        "yccd",
        "trong_so",
        "can_cu"
       ],
       "properties": {
        "chu_de": {
         "type": "string"
        },
        "dang_tx": {
         "type": [
          "array",
          "null"
         ]
        },
        "yccd": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "string",
          "pattern": "^(10|11|12)\\.[A-Z]+\\.[0-9]+$"
         }
        },
        "trong_so": {
         "type": "number",
         "exclusiveMinimum": 0,
         "maximum": 1
        },
        "can_cu": {
         "type": "string",
         "minLength": 10
        }
       }
      }
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "loai_o": {
         "const": "co-dinh"
        }
       }
      },
      "then": {
       "required": [
        "chu_de",
        "yccd",
        "can_cu"
       ]
      }
     },
     {
      "if": {
       "properties": {
        "loai_o": {
         "const": "xoay-vong"
        }
       }
      },
      "then": {
       "required": [
        "nhom"
       ]
      }
     }
    ]
   }
  },
  "bang": {
   "type": "array",
   "description": "hàng chủ đề × cột loại câu|mức độ (ô xoay vòng tính kì vọng theo trọng số)"
  }
 }
}