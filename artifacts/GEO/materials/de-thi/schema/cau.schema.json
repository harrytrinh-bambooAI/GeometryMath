{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "cau.schema.json",
 "title": "Câu trong ngân hàng đề (v1.0 · 27/11/2026)",
 "type": "object",
 "required": [
  "id",
  "mau_cau",
  "bien_the",
  "chu_de",
  "dang",
  "dang_tx",
  "lop",
  "yccd",
  "kien_thuc",
  "loai_cau",
  "muc_do",
  "nang_luc",
  "thoi_gian_phut",
  "diem",
  "do_kho",
  "boi_canh_key",
  "de_bai",
  "dap_an",
  "dap_so",
  "nhieu",
  "nguon",
  "dap_so_engine"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^MC-[A-Z0-9-]+\\.(TN|DS|TLN|TL)\\.[0-9]+$"
  },
  "mau_cau": {
   "type": "string"
  },
  "bien_the": {
   "type": "object"
  },
  "chu_de": {
   "type": "string",
   "description": "id chủ đề theo lich-su/taxonomy.json"
  },
  "dang": {
   "type": "string",
   "description": "dạng chi tiết (mỗi mẫu câu một dạng); ràng buộc không trùng dạng dùng trường này"
  },
  "dang_tx": {
   "type": "string",
   "description": "dạng theo lich-su/taxonomy.json"
  },
  "lop": {
   "enum": [
    10,
    11,
    12
   ]
  },
  "yccd": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^(10|11|12)\\.[A-Z]+\\.[0-9]+$"
   }
  },
  "kien_thuc": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "loai_cau": {
   "enum": [
    "tn4",
    "dung-sai",
    "tra-loi-ngan",
    "tu-luan"
   ]
  },
  "muc_do": {
   "enum": [
    "NB",
    "TH",
    "VD",
    "VDC"
   ]
  },
  "nang_luc": {
   "enum": [
    "tu-duy-lap-luan",
    "mo-hinh-hoa",
    "giai-quyet-van-de",
    "giao-tiep",
    "cong-cu"
   ]
  },
  "thoi_gian_phut": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "diem": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "do_kho": {
   "type": "number",
   "minimum": 0,
   "maximum": 1,
   "description": "độ khó dự kiến = tỉ lệ làm sai dự kiến"
  },
  "boi_canh_key": {
   "type": "string"
  },
  "de_bai": {
   "type": "string",
   "minLength": 10
  },
  "dap_an": {
   "type": "string",
   "minLength": 1
  },
  "dap_so": {
   "type": "object",
   "required": [
    "gia_tri",
    "so"
   ],
   "properties": {
    "gia_tri": {
     "type": "string"
    },
    "so": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "dap_so_engine": {
   "type": [
    "number",
    "null"
   ]
  },
  "nhieu": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "phuong_an",
     "loi"
    ],
    "properties": {
     "phuong_an": {
      "type": "string"
     },
     "loi": {
      "type": "object",
      "required": [
       "loai_loi",
       "mo_ta"
      ],
      "properties": {
       "loai_loi": {
        "enum": [
         "sai-tinh-toan",
         "sai-dinh-li",
         "sai-hinh-dung",
         "nham-dieu-kien",
         "thieu-chung-minh"
        ]
       },
       "mo_ta": {
        "type": "string",
        "minLength": 5
       }
      }
     }
    }
   }
  },
  "lua_chon": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "object",
    "required": [
     "noi_dung",
     "dung"
    ],
    "properties": {
     "noi_dung": {
      "type": "string"
     },
     "dung": {
      "type": "boolean"
     },
     "loi": {
      "type": "object",
      "required": [
       "loai_loi",
       "mo_ta"
      ],
      "properties": {
       "loai_loi": {
        "enum": [
         "sai-tinh-toan",
         "sai-dinh-li",
         "sai-hinh-dung",
         "nham-dieu-kien",
         "thieu-chung-minh"
        ]
       },
       "mo_ta": {
        "type": "string",
        "minLength": 5
       }
      }
     }
    }
   }
  },
  "y": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "object",
    "required": [
     "nhan",
     "menh_de",
     "dung",
     "muc_do"
    ],
    "properties": {
     "nhan": {
      "enum": [
       "a",
       "b",
       "c",
       "d"
      ]
     },
     "menh_de": {
      "type": "string"
     },
     "dung": {
      "type": "boolean"
     },
     "muc_do": {
      "enum": [
       "NB",
       "TH",
       "VD",
       "VDC"
      ]
     },
     "loi": {
      "type": "object",
      "required": [
       "loai_loi",
       "mo_ta"
      ],
      "properties": {
       "loai_loi": {
        "enum": [
         "sai-tinh-toan",
         "sai-dinh-li",
         "sai-hinh-dung",
         "nham-dieu-kien",
         "thieu-chung-minh"
        ]
       },
       "mo_ta": {
        "type": "string",
        "minLength": 5
       }
      }
     }
    }
   }
  },
  "huong_dan_cham": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "required": [
     "buoc",
     "noi_dung",
     "diem"
    ],
    "properties": {
     "buoc": {
      "type": "string"
     },
     "noi_dung": {
      "type": "string"
     },
     "diem": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    }
   }
  },
  "nguon": {
   "type": "object",
   "required": [
    "loai",
    "ma"
   ],
   "properties": {
    "loai": {
     "enum": [
      "mvp",
      "tu-soan",
      "chinh-thuc"
     ]
    },
    "ma": {
     "type": "string"
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "loai_cau": {
      "const": "tn4"
     }
    }
   },
   "then": {
    "required": [
     "lua_chon"
    ],
    "properties": {
     "nhieu": {
      "minItems": 3,
      "maxItems": 3
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "loai_cau": {
      "const": "dung-sai"
     }
    }
   },
   "then": {
    "required": [
     "y"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "loai_cau": {
      "const": "tra-loi-ngan"
     }
    }
   },
   "then": {
    "properties": {
     "dap_an": {
      "type": "string",
      "pattern": "^-?[0-9]+(,[0-9]+)?$",
      "maxLength": 4
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "loai_cau": {
      "const": "tu-luan"
     }
    }
   },
   "then": {
    "required": [
     "huong_dan_cham"
    ]
   }
  }
 ]
}