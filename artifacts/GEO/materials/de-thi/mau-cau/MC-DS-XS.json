 "dan_xuat": {
  "P1": "100*p",
  "U": "100*u",
  "V": "100*v"
 },
 "boi_canh": "Một bệnh viện nhận bệnh nhân từ hai khu vực: khu vực I chiếm ${P1}\\%$; tỉ lệ mắc bệnh X ở khu vực I là ${U}\\%$, ở khu vực II là ${V}\\%$. Chọn ngẫu nhiên một bệnh nhân; gọi $H$: \\\"bệnh nhân đến từ khu vực I\\\", $A$: \\\"bệnh nhân mắc bệnh X\\\".",
 "kieu": "xap-xi:4",
 "y": [
  {
   "menh_de": "$P(\\overline H)={v}$.",
   "dap_so": "1-p",
   "muc_do": "NB",
   "nhieu": [
    {
     "bieu_thuc": "p",
     "loi": {
      "loai_loi": "sai-dinh-li",
      "mo_ta": "Nhầm $P(\\overline H)$ với $P(H)$"
     }
    }
   ]
  },
  {
   "menh_de": "$P(AH)={v}$.",
   "dap_so": "p*u",
   "muc_do": "TH",
   "nhieu": [
    {
     "bieu_thuc": "u",
     "loi": {
      "loai_loi": "sai-dinh-li",
      "mo_ta": "Quên nhân $P(H)$: lấy $P(A\\mid H)$"
     }
    }
   ]
  },
  {
   "menh_de": "$P(A)={v}$.",
   "dap_so": "p*u+(1-p)*v",
   "muc_do": "VD",
   "nhieu": [
    {
     "bieu_thuc": "(u+v)/2",
     "loi": {
      "loai_loi": "sai-dinh-li",
      "mo_ta": "Lấy trung bình cộng không theo tỉ trọng"
     }
    }
   ]
  },
  {
   "menh_de": "$P(H\\mid A)={v}$ (làm tròn đến hàng phần nghìn).",
   "dap_so": "p*u/(p*u+(1-p)*v)",
   "muc_do": "VD",
   "nhieu": [
    {
     "bieu_thuc": "u",
     "loi": {
      "loai_loi": "sai-dinh-li",
      "mo_ta": "Nhầm $P(H\\mid A)$ với $P(A\\mid H)$"
     }
    }
   ],
   "kieu": "xap-xi:3"
  }
 ],
