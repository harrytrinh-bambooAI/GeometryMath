    "responseBody": "{\"items\":[{\"id\":\"00000000-0000-7000-8000-000000000031\",\"code\":\"HKG-01\",\"level\":\"thpt\",\"solidKind\":\"pyramid\",\"topic\":\"Góc\",\"versionId\":\"00000000-0000-7000-8000-000000100031\",\"statement\":\"Cho hình chóp S.ABCD, đáy là hình vuông cạnh a, SA ⊥ (ABCD), SA = a. Tính góc giữa SD và mặt đáy.\",\"verifyStatus\":\"verified\"},{\"id\":\"00000000-0000-7000-8000-000000000032\",\"code\":\"HKG-02\",\"level\":\"thpt\",\"solidKind\":\"cube\",\"topic\":\"Khoảng cách\",\"versionId\":\"00000000-0000-7000-8000-000000100032\",\"statement\":\"Cho hình lập phương ABCD.A′B′C′D′ cạnh a. Tính khoảng cách giữa AC và B′D′.\",\"verifyStatus\":\"verified\"},{\"id\":\"00000000-0000-7000-8000-000000000033\",\"code\":\"HKG-03\",\"level\":\"thcs\",\"solidKind\":\"prism\",\"topic\":\"Thể tích\",\"versionId\":\"00000000-0000-7000-8000-000000100033\",\"statement\":\"Lăng trụ đứng tam giác có đáy là tam giác đều cạnh 4 cm, chiều cao 6 cm. Tính thể tích.\",\"verifyStatus\":\"verified\"},{\"id\":\"00000000-0000-7000-8000-000000000034\",\"code\":\"HKG-04\",\"level\":\"thcs\",\"solidKind\":\"cone\",\"topic\":\"Thể tích\",\"versionId\":\"00000000-0000-7000-8000-000000100034\",\"statement\":\"Hình nón có bán kính đáy 3 cm, đường sinh 5 cm. Tính diện tích xung quanh và thể tích.\",\"verifyStatus\":\"verified\"},{\"id\":\"00000000-0000-7000-8000-000000000035\",\"code\":\"HKG-05\",\"level\":\"thcs\",\"solidKind\":\"cylinder\",\"topic\":\"Diện tích\",\"versionId\":\"00000000-0000-7000-8000-000000100035\",\"statement\":\"Hình trụ có chiều cao 10 cm, bán kính đáy 4 cm. Tính diện tích toàn phần.\",\"verifyStatus\":\"verified\"},{\"id\":\"00000000-0000-7000-8000-000000000036\",\"code\":\"HKG-06\",\"level\":\"thpt\",\"solidKind\":\"sphere\",\"topic\":\"Mặt cầu\",\"versionId\":\"00000000-0000-7000-8000-000000100036\",\"statement\":\"Mặt cầu ngoại tiếp hình lập phương cạnh a. Tính bán kính và thể tích khối cầu.\",\"verifyStatus\":\"verified\"}]}",
