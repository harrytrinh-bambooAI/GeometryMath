  "notes": [],
  "scenes": [
    {
      "code": "00-hook",
      "kind": "slide",
      "start": 0,
      "duration": 32.87,
      "voice": "00-hook.wav",
      "voiceDur": 30.26,
      "cues": [
        {
          "start": 0.6,
          "end": 2.57,
          "lines": [
            "Chín giờ rưỡi tối thứ Năm."
          ]
        },
        {
          "start": 2.57,
          "end": 8.56,
          "lines": [
            "Cô Lan, giáo viên Toán lớp 11A1, còn một",
            "chồng bài kiểm tra viết tay chưa chấm,"
          ]
        },
        {
          "start": 8.56,
          "end": 13.11,
          "lines": [
            "đề kiểm tra tuần sau chưa ra,",
            "và giáo án tiết sau chưa xong."
          ]
        },
        {
          "start": 13.11,
          "end": 17.59,
          "lines": [
            "Cùng lúc đó, học sinh Bình An",
            "đang kẹt ở một bài hình chóp."
          ]
        },
        {
          "start": 17.59,
          "end": 21.68,
          "lines": [
            "Em hỏi một AI chung chung,",
            "nhận ngay đáp số, chép lại,"
          ]
        },
        {
          "start": 21.68,
          "end": 24.34,
          "lines": [
            "và sáng mai lên lớp vẫn không hiểu."
          ]
        },
        {
          "start": 24.34,
          "end": 27.83,
          "lines": [
            "Nếu có một trợ lý hiểu",
            "hình học, hiểu lớp học,"
          ]
        },
        {
          "start": 27.83,
          "end": 30.86,
          "lines": [
            "và luôn để giáo viên quyết định thì sao?"
          ]
        }
      ]
    },
    {
      "code": "01-mo-dau",
      "kind": "slide",
      "start": 32.87,
      "duration": 16.18,
      "voice": "01-mo-dau.wav",
      "voiceDur": 13.58,
      "cues": [
        {
          "start": 33.47,
          "end": 36.43,
          "lines": [
            "Xin giới thiệu Hình",
            "Học Không Gian Cùng AI,"
          ]
        },
        {
          "start": 36.43,
          "end": 40.5,
          "lines": [
            "do BambooAI phát triển cho giáo",
            "viên và học sinh trung học."
          ]
        },
        {
          "start": 40.5,
          "end": 43.73,
          "lines": [
            "AI rất mạnh, nhưng tư",
            "duy vẫn là của con người."
          ]
        },
        {
          "start": 43.73,
          "end": 47.04,
          "lines": [
            "Đó là nguyên tắc của mọi",
            "tính năng bạn sắp thấy."
          ]
        }
      ]
    },
    {
      "code": "02-van-de",
      "kind": "slide",
      "start": 49.04,
      "duration": 21.41,
      "voice": "02-van-de.wav",
      "voiceDur": 18.81,
      "cues": [
        {
          "start": 49.64,
          "end": 51.78,
          "lines": [
            "Vì sao cần một công cụ riêng?"
          ]
        },
        {
          "start": 51.78,
          "end": 54.95,
          "lines": [
            "Vì hình không gian khó",
            "hình dung trên giấy."
          ]
        },
        {
          "start": 54.95,
          "end": 60.86,
          "lines": [
            "Vì AI thông thường có thể tính sai mà vẫn",
            "rất tự tin, và hay đưa đáp số quá sớm."
          ]
        },
        {
          "start": 60.86,
          "end": 66.76,
          "lines": [
            "Và vì giáo viên đang mất rất nhiều giờ",
            "mỗi tuần cho những việc lặp lại: soạn đề,"
          ]
        },
        {
          "start": 66.76,
          "end": 68.46,
          "lines": [
            "soạn giáo án, chấm bài."
          ]
        }
      ]
    },
    {
      "code": "03-gioi-thieu",
      "kind": "slide",
      "start": 70.46,
      "duration": 20.03,
      "voice": "03-gioi-thieu.wav",
      "voiceDur": 17.43,
      "cues": [
        {
          "start": 71.06,
          "end": 72.48,
          "lines": [
            "Hệ thống có ba vai."
          ]
        },
        {
          "start": 72.48,
          "end": 76.37,
          "lines": [
            "Học sinh nhìn thấy hình,",
            "tự tay thử, và hiểu vì sao."
          ]
        },
        {
          "start": 76.37,
          "end": 81.46,
          "lines": [
            "Giáo viên được đỡ công soạn và chấm,",
            "nhưng vẫn quyết định cuối cùng."
          ]
        },
        {
          "start": 81.46,
          "end": 85.87,
          "lines": [
            "Còn AI đề xuất, và một engine",
            "hình học tính lại mọi đáp số."
          ]
        },
        {
          "start": 85.87,
          "end": 88.49,
          "lines": [
            "AI thực hiện, con người quyết định."
          ]
        }
      ]
    },
    {
      "code": "04-chuong-hinh-hoc",
      "kind": "slide",
      "start": 90.49,
      "duration": 9.77,
      "voice": "04-chuong-hinh-hoc.wav",
      "voiceDur": 7.17,
      "cues": [
        {
          "start": 91.09,
          "end": 93.08,
          "lines": [
            "Chương một: hỗ trợ hình học."
          ]
        },
        {
          "start": 93.08,
          "end": 98.26,
          "lines": [
            "Hãy bắt đầu với điều mà AI thông thường",
            "hay làm sai nhất: hình và đáp số."
          ]
        }
      ]
    },
    {
      "code": "05-kho-de-that",
      "kind": "clip",
      "start": 100.26,
      "duration": 21.37,
      "voice": "05-kho-de-that.wav",
      "voiceDur": 19.17,
      "cues": [
        {
          "start": 100.86,
          "end": 106.5,
          "lines": [
            "Đây là kho đề, chứa chính các bài",
            "trong ngân hàng bài tập của tổ Toán:"
          ]
        },
        {
          "start": 106.5,
          "end": 111.9,
          "lines": [
            "bài HKG-01 về góc trong hình chóp,",
            "bài HKG-03 về thể tích lăng trụ,"
          ]
        },
        {
          "start": 111.9,
          "end": 113.35,
          "lines": [
            "và nhiều bài khác."
          ]
        },
        {
          "start": 113.35,
          "end": 117.21,
          "lines": [
            "Giáo viên lọc theo cấp",
            "học, loại hình và chủ đề."
          ]
        },
        {
          "start": 117.21,
          "end": 120.03,
          "lines": [
            "Bài nào cũng có nhãn đã kiểm chứng."
          ]
        }
      ]
    },
    {
      "code": "06-wow-dung-hinh",
      "kind": "clip",
      "start": 121.63,
      "duration": 30.61,
      "voice": "06-wow-dung-hinh.wav",
      "voiceDur": 28.41,
      "cues": [
        {
          "start": 122.23,
          "end": 125.25,
          "lines": [
            "Còn một đề hoàn toàn mới thì sao?"
          ]
        },
        {
          "start": 125.25,
          "end": 130.94,
          "lines": [
            "Cô Lan chỉ cần gõ đề, như viết",
            "lên bảng: cho hình chóp S.ABCD,"
          ]
        },
        {
          "start": 130.94,
          "end": 137.72,
          "lines": [
            "đáy là hình vuông cạnh a, SA ⊥ đáy,",
            "SA = a√2, tính góc giữa SC và mặt đáy."
          ]
        },
        {
          "start": 137.72,
          "end": 139,
          "lines": [
            "Bấm Dựng hình."
          ]
        },
        {
          "start": 139,
          "end": 143.22,
          "lines": [
            "Hệ thống đọc đề, dựng",
            "hình 3D, giải từng bước,"
          ]
        },
        {
          "start": 143.22,
          "end": 147.52,
          "lines": [
            "và cuối cùng tự kiểm",
            "chứng bằng tính toán. 45°."
          ]
        },
        {
          "start": 147.52,
          "end": 150.64,
          "lines": [
            "Đã kiểm chứng. Chỉ trong vài giây."
          ]
        }
      ]
    },
    {
      "code": "07-chi-tiet-kiem-chung",
      "kind": "clip",
      "start": 152.24,
      "duration": 21.97,
      "voice": "07-chi-tiet-kiem-chung.wav",
      "voiceDur": 19.75,
      "cues": [
        {
          "start": 152.84,
          "end": 157.22,
          "lines": [
            "Mở một bài trong kho, ví dụ",
            "bài góc giữa SD và mặt đáy."
          ]
        },
        {
          "start": 157.22,
          "end": 159.69,
          "lines": [
            "Mỗi bài có đề, hình 3D, đáp số,"
          ]
        },
        {
          "start": 159.69,
          "end": 163.67,
          "lines": [
            "và lời giải từng bước theo",
            "đúng định hướng của tổ:"
          ]
        },
        {
          "start": 163.67,
          "end": 166.62,
          "lines": [
            "ưu tiên hình chiếu và tam giác vuông."
          ]
        },
        {
          "start": 166.62,
          "end": 172.59,
          "lines": [
            "Đáp số này không phải do AI tự nói, mà",
            "khớp với kết quả engine tự tính lại."
          ]
        }
      ]
    },
    {
      "code": "08-xoay-ve-do",
      "kind": "clip",
      "start": 174.2,
      "duration": 24,
      "voice": "08-xoay-ve-do.wav",
      "voiceDur": 21.8,
      "cues": [
        {
          "start": 174.8,
          "end": 176.89,
          "lines": [
            "Bây giờ là phía Bình An."
          ]
        },
        {
          "start": 176.89,
          "end": 183.06,
          "lines": [
            "Hình chóp không còn nằm im trên giấy:",
            "em kéo để xoay, nhìn từ mọi phía,"
          ]
        },
        {
          "start": 183.06,
          "end": 185.83,
          "lines": [
            "và tự thấy SA vuông góc với đáy."
          ]
        },
        {
          "start": 185.83,
          "end": 190.7,
          "lines": [
            "Em vẽ thêm đoạn BD, đo SD",
            "được a√2, đo góc SAD được 90°."
          ]
        },
        {
          "start": 190.7,
          "end": 196.6,
          "lines": [
            "Riêng đại lượng là đáp số thì được",
            "khoá, để em vẫn phải tự suy luận."
          ]
        }
      ]
    },
    {
      "code": "09-trinh-chieu",
      "kind": "clip",
      "start": 198.2,
      "duration": 18,
      "voice": "09-trinh-chieu.wav",
      "voiceDur": 14.14,
      "cues": [
        {
          "start": 198.8,
          "end": 202.56,
          "lines": [
            "Trên lớp, cô Lan trình chiếu",
            "bài toán toàn màn hình."
          ]
        },
        {
          "start": 202.56,
          "end": 205.58,
          "lines": [
            "Lời giải được che, và cô mở từng bước một."
          ]
        },
        {
          "start": 205.58,
          "end": 209.12,
          "lines": [
            "Mỗi bước, hình tô sáng",
            "đúng các yếu tố đang dùng."
          ]
        },
        {
          "start": 209.12,
          "end": 212.94,
          "lines": [
            "Cả lớp cùng dự đoán trước",
            "khi bước tiếp theo hiện ra."
          ]
        }
      ]
    },
    {
      "code": "10-chuong-ai",
      "kind": "slide",
      "start": 216.2,
      "duration": 10.24,
      "voice": "10-chuong-ai.wav",
      "voiceDur": 7.65,
      "cues": [
        {
          "start": 216.8,
          "end": 219.85,
          "lines": [
            "Chương hai: AI đồng hành cùng học sinh."
          ]
        },
        {
          "start": 219.85,
          "end": 224.45,
          "lines": [
            "Gợi ý trước, lời giải sau, và",
            "mọi câu trả lời đều có nguồn."
          ]
        }
      ]
    },
    {
      "code": "11-vao-lop-goi-y",
      "kind": "clip",
      "start": 226.45,
      "duration": 23.44,
      "voice": "11-vao-lop-goi-y.wav",
      "voiceDur": 19.31,
      "cues": [
        {
          "start": 227.05,
          "end": 231.78,
          "lines": [
            "Học sinh vào lớp chỉ bằng tên",
            "và mã lớp, không cần tài khoản."
          ]
        },
        {
          "start": 231.78,
          "end": 234.26,
          "lines": [
            "Khi vướng, Bình An mở gợi ý một:"
          ]
        },
        {
          "start": 234.26,
          "end": 239.23,
          "lines": [
            "góc giữa đường và mặt là góc giữa",
            "đường đó và hình chiếu của nó."
          ]
        },
        {
          "start": 239.23,
          "end": 241.32,
          "lines": [
            "Gợi ý hai chỉ bước kế tiếp."
          ]
        },
        {
          "start": 241.32,
          "end": 244.04,
          "lines": [
            "Còn lời giải thì chờ đến giờ cô mở."
          ]
        },
        {
          "start": 244.04,
          "end": 246.36,
          "lines": [
            "Không ai bị lộ đáp án quá sớm."
          ]
        }
      ]
    },
    {
      "code": "12-bai-luyen",
      "kind": "clip",
      "start": 249.89,
      "duration": 18.6,
      "voice": "12-bai-luyen.wav",
      "voiceDur": 16.39,
      "cues": [
        {
          "start": 250.49,
          "end": 254.7,
          "lines": [
            "Với bài luyện, cô chọn những",
            "bài mà máy kiểm được đáp số."
          ]
        },
        {
          "start": 254.7,
          "end": 258.83,
          "lines": [
            "Học sinh nhập đáp số trên bàn",
            "phím toán, có ba lượt thử."
          ]
        },
        {
          "start": 258.83,
          "end": 264.52,
          "lines": [
            "Sai thì được báo ngay kèm một gợi ý;",
            "đúng thì được xác nhận và sang câu tiếp."
          ]
        },
        {
          "start": 264.52,
          "end": 266.88,
          "lines": [
            "Cô không phải chấm tay từng câu."
          ]
        }
      ]
    },
    {
      "code": "13-kho-tri-thuc",
      "kind": "clip",
      "start": 268.49,
      "duration": 16.65,
      "voice": "13-kho-tri-thuc.wav",
      "voiceDur": 14.45,
      "cues": [
        {
          "start": 269.09,
          "end": 274.99,
          "lines": [
            "Muốn AI trả lời đúng với lớp mình, cô Lan",
            "đưa tài liệu của lớp vào kho tri thức."
          ]
        },
        {
          "start": 274.99,
          "end": 280.74,
          "lines": [
            "Mỗi tài liệu có phiên bản và trạng thái:",
            "đang dùng, chờ duyệt, hay đã lưu trữ."
          ]
        },
        {
          "start": 280.74,
          "end": 283.54,
          "lines": [
            "AI chỉ được dùng những gì cô đã duyệt."
          ]
        }
      ]
    },
    {
      "code": "14-wow-hoi-dap",
      "kind": "clip",
      "start": 285.14,
      "duration": 24.42,
      "voice": "14-wow-hoi-dap.wav",
      "voiceDur": 22.22,
      "cues": [
        {
          "start": 285.74,
          "end": 287.87,
          "lines": [
            "Và đây là khác biệt thứ hai."
          ]
        },
        {
          "start": 287.87,
          "end": 290.3,
          "lines": [
            "Trước giờ kiểm tra, Bình An hỏi:"
          ]
        },
        {
          "start": 290.3,
          "end": 295.33,
          "lines": [
            "muốn tính khoảng cách từ A đến mặt",
            "phẳng (SBC) thì bắt đầu từ đâu?"
          ]
        },
        {
          "start": 295.33,
          "end": 296.85,
          "lines": [
            "AI không đưa đáp số."
          ]
        },
        {
          "start": 296.85,
          "end": 302.55,
          "lines": [
            "Nó giải thích cách nghĩ, gợi ý em tìm",
            "mặt phẳng vuông góc, và ghi rõ nguồn."
          ]
        },
        {
          "start": 302.55,
          "end": 307.95,
          "lines": [
            "Bấm vào nguồn, em đọc đúng đoạn trong",
            "ghi chú Khoảng cách của lớp 11A1."
          ]
        }
      ]
    },
    {
      "code": "15-chuong-soan",
      "kind": "slide",
      "start": 309.56,
      "duration": 8.91,
      "voice": "15-chuong-soan.wav",
      "voiceDur": 6.31,
      "cues": [
        {
          "start": 310.16,
          "end": 312.75,
          "lines": [
            "Chương ba: soạn giáo án và soạn đề."
          ]
        },
        {
          "start": 312.75,
          "end": 316.47,
          "lines": [
            "Đây là nơi cô Lan lấy lại",
            "những buổi tối của mình."
          ]
        }
      ]
    },
    {
      "code": "16-soan-giao-an",
      "kind": "clip",
      "start": 318.47,
      "duration": 34.07,
      "voice": "16-soan-giao-an.wav",
      "voiceDur": 31.86,
      "cues": [
        {
          "start": 319.07,
          "end": 323.95,
          "lines": [
            "Soạn giáo án theo phân phối chương",
            "trình: cô chọn chương, bài 24,"
          ]
        },
        {
          "start": 323.95,
          "end": 328.98,
          "lines": [
            "góc giữa đường thẳng và mặt phẳng,",
            "chọn tiết và đối tượng học sinh."
          ]
        },
        {
          "start": 328.98,
          "end": 332.29,
          "lines": [
            "AI soạn bản nháp đầy",
            "đủ: mục tiêu, thiết bị,"
          ]
        },
        {
          "start": 332.29,
          "end": 336.72,
          "lines": [
            "tiến trình từng hoạt động với",
            "thời lượng, và phiếu học tập."
          ]
        },
        {
          "start": 336.72,
          "end": 342.81,
          "lines": [
            "Nội dung bám đúng giáo án lớp 11A1: khởi",
            "động bằng hình chóp xoay trên máy chiếu,"
          ]
        },
        {
          "start": 342.81,
          "end": 345.51,
          "lines": [
            "hình thành kiến thức qua bài HKG-01."
          ]
        },
        {
          "start": 345.51,
          "end": 350.92,
          "lines": [
            "Mọi mục đều sửa được, và bản nháp gắn",
            "nhãn AI soạn cho đến khi cô duyệt."
          ]
        }
      ]
    },
    {
      "code": "17-ra-de-ma-tran",
      "kind": "clip",
      "start": 352.53,
      "duration": 24.53,
      "voice": "17-ra-de-ma-tran.wav",
      "voiceDur": 22.33,
      "cues": [
        {
          "start": 353.13,
          "end": 357.21,
          "lines": [
            "Đề kiểm tra tuần sau? Cô chọn",
            "loại đề kiểm tra 15 phút."
          ]
        },
        {
          "start": 357.21,
          "end": 363,
          "lines": [
